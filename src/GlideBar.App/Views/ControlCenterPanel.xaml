<UserControl x:Class="GlideBar.App.Views.ControlCenterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:GlideBar.App.Views"
             xmlns:vm="clr-namespace:GlideBar.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BarViewModel}"
             FontFamily="Segoe UI Variable Text, Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>

        <!-- Uppercase section label -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>

    <!-- Popup surface (matches the Add/Settings flyouts: gradient, edge-light stroke, contained glow).
         Uniform margin leaves room for the glow; the code-behind placement puts the visible border a
         few px from the bar on whichever side faces the screen interior. -->
    <Border Background="{DynamicResource SurfaceGradientBrush}" CornerRadius="16" Padding="14" Margin="12"
            BorderBrush="{DynamicResource SurfaceStrokeBrush}" BorderThickness="1.2"
            Width="560">
        <Border.Effect>
            <DropShadowEffect BlurRadius="11" ShadowDepth="0" Opacity="0.4"
                              Color="{DynamicResource SurfaceGlowColor}"/>
        </Border.Effect>

        <StackPanel>
            <!-- ===== Apps & folders quick line ===== -->
            <Grid Margin="2,0,2,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="APPS &amp; FOLDERS" Style="{StaticResource SectionLabel}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Pins.Pins}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GlideTileButton}" Width="36" Height="36" Margin="2"
                                    Command="{Binding OpenCommand}" ToolTip="{Binding Name}">
                                <Grid>
                                    <Path Style="{StaticResource PinIcon}" Width="17" Height="17"/>
                                    <Image Source="{Binding Icon}" Width="22" Height="22"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Grid.Column="2" Style="{StaticResource GlideTileButton}" Width="36" Height="36" Margin="2"
                        Command="{Binding ToggleAddCommand}" VerticalAlignment="Center"
                        ToolTip="Add apps, files or folders">
                    <Path Data="{StaticResource IconAdd}" Stretch="Uniform" Width="14" Height="14"
                          Fill="{DynamicResource TextSecondaryBrush}"/>
                </Button>
            </Grid>

            <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,12"/>

            <!-- ===== Two columns: Now Playing | Notifications ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Now Playing -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" Margin="2,0,0,10"/>

                    <!-- Cards -->
                    <ScrollViewer MaxHeight="330" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Visibility="{Binding Media.HasSessions, Converter={StaticResource B2V}}">
                        <ItemsControl ItemsSource="{Binding Media.Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <views:NowPlayingCard Margin="0,0,0,10"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty state -->
                    <Border CornerRadius="12" Padding="18,22" Margin="0,2,0,0"
                            Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            Visibility="{Binding Media.HasSessions, Converter={StaticResource InverseB2V}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource IconMusicNote}" Stretch="Uniform" Width="22" Height="22"
                                  Fill="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nothing is playing right now" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                                       TextAlignment="Center"/>
                            <TextBlock Text="Start Spotify, a video, or a local track and it'll show up here."
                                       Margin="0,3,0,0" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="11" Opacity="0.8" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="240"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Divider -->
                <Border Grid.Column="1" Width="1" Margin="14,2" Background="{DynamicResource DividerBrush}"/>

                <!-- Notifications -->
                <StackPanel Grid.Column="2" DataContext="{Binding Notifications}">
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="NOTIFICATIONS" Style="{StaticResource SectionLabel}"
                                   HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        <Button Content="Clear all" HorizontalAlignment="Right" Cursor="Hand"
                                Command="{Binding ClearAllCommand}"
                                Visibility="{Binding HasItems, Converter={StaticResource B2V}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <TextBlock Text="Clear all" Foreground="{DynamicResource AccentBrush}" FontSize="11.5"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Items}"
                                  Visibility="{Binding HasItems, Converter={StaticResource B2V}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource FieldBrush}" CornerRadius="12" Padding="11"
                                        Margin="0,0,0,8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AppName}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                        <TextBlock Text="{Binding Body}" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty / unsupported state -->
                    <Border CornerRadius="12" Padding="16,20" Background="{DynamicResource FieldBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                            Visibility="{Binding HasItems, Converter={StaticResource InverseB2V}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="You're all caught up" Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12.5" TextAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Opacity="0.8"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="220"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
