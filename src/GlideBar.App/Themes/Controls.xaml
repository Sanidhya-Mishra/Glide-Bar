    <PathGeometry x:Key="IconSettings" FillRule="Nonzero" Figures="M12.01 2.25c.74 0 1.47.1 2.18.25.32.07.55.33.59.65l.17 1.53a1.38 1.38 0 0 0 1.92 1.11l1.4-.61c.3-.13.64-.06.85.17a9.8 9.8 0 0 1 2.2 3.8c.1.3 0 .63-.26.82l-1.25.92a1.38 1.38 0 0 0 0 2.22l1.25.92c.26.19.36.52.27.82a9.8 9.8 0 0 1-2.2 3.8.75.75 0 0 1-.85.17l-1.4-.62a1.38 1.38 0 0 0-1.93 1.12l-.17 1.52a.75.75 0 0 1-.58.65 9.52 9.52 0 0 1-4.4 0 .75.75 0 0 1-.57-.65l-.17-1.52a1.38 1.38 0 0 0-1.93-1.11l-1.4.62a.75.75 0 0 1-.85-.18 9.8 9.8 0 0 1-2.2-3.8c-.1-.3 0-.63.26-.82l1.25-.92a1.38 1.38 0 0 0 0-2.22l-1.24-.92a.75.75 0 0 1-.28-.82 9.8 9.8 0 0 1 2.2-3.8c.23-.23.57-.3.86-.17l1.4.62c.4.17.86.15 1.25-.08.38-.22.63-.6.68-1.04l.17-1.53a.75.75 0 0 1 .58-.65c.72-.16 1.45-.24 2.2-.25ZM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/>

    <!-- Pin-tile icon: picks its geometry from the item's Kind. -->
    <Style x:Key="PinIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="19"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Data" Value="{StaticResource IconDocument}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Folder">
                <Setter Property="Data" Value="{StaticResource IconFolder}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="App">
                <Setter Property="Data" Value="{StaticResource IconApp}"/>
            </DataTrigger>
            <!-- Hide the generic glyph once the target's real shell icon has loaded. -->
            <DataTrigger Binding="{Binding HasIcon}" Value="True">
                <Setter Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ================= RingGauge default style ================= -->
    <Style TargetType="{x:Type controls:RingGauge}">
        <Setter Property="TrackBrush" Value="{DynamicResource GaugeTrackBrush}"/>
        <Setter Property="ArcBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="GoodBrush" Value="{DynamicResource GoodBrush}"/>
        <Setter Property="WarnBrush" Value="{DynamicResource WarnBrush}"/>
        <Setter Property="CriticalBrush" Value="{DynamicResource CriticalBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="RingThickness" Value="5"/>
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RingGauge}">
                    <Grid>
                        <Path x:Name="PART_Track" Stroke="{TemplateBinding TrackBrush}"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Path x:Name="PART_Arc"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{TemplateBinding DisplayValue}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="12.5" FontWeight="SemiBold" TextAlignment="Center"
                                       Typography.NumeralAlignment="Tabular"/>
                            <TextBlock Text="{TemplateBinding Label}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="8" TextAlignment="Center" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Pinned tile button ================= -->
    <Style x:Key="GlideTileButton" TargetType="Button">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{DynamicResource TileBrush}"
                            CornerRadius="{DynamicResource TileCornerRadius}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Icon button (settings / search toggle) ================= -->
    <Style x:Key="GlideIconButton" TargetType="Button">
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets, Segoe Fluent Icons"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TileBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Search field ================= -->
    <Style x:Key="GlideSearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="2,0">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Divider ================= -->
    <Style x:Key="GlideDividerV" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="7,8"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    </Style>
    <Style x:Key="GlideDividerH" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Margin" Value="8,7"/>
        <Setter Property="Background" Value="{DynamicResource DividerBrush}"/>
    </Style>

    <!-- ================= Settings flyout controls ================= -->
    <Style x:Key="SettingLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Segmented button (theme / rate). Active = accent, driven by the button's Tag (a bool). -->
    <Style x:Key="SegBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="10,5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource TileBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pill toggle switch -->
    <Style x:Key="SettingToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="11" Background="{DynamicResource TileBrush}"
                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1">
                        <Ellipse x:Name="thumb" Width="16" Height="16" Fill="{DynamicResource TextSecondaryBrush}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="thumb" Property="Fill" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Search result row ================= -->
    <Style x:Key="ResultIcon" TargetType="Path">
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Width" Value="17"/>
        <Setter Property="Height" Value="17"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="Data" Value="{StaticResource IconDocument}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Kind}" Value="Folder">
                <Setter Property="Data" Value="{StaticResource IconFolder}"/>
                <Setter Property="Fill" Value="{DynamicResource AccentBrush}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Kind}" Value="App">
                <Setter Property="Data" Value="{StaticResource IconApp}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="SearchResultTemplate">
        <Button HorizontalContentAlignment="Stretch" Cursor="Hand"
                Command="{Binding DataContext.Search.OpenCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                CommandParameter="{Binding}">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="9,7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Style="{StaticResource ResultIcon}" Margin="0,0,11,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Path}" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TileBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </DataTemplate>

    <!-- ================= Thin minimal scrollbar ================= -->
    <Style x:Key="GlideScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="4" Margin="2" Background="{DynamicResource ScrollThumbBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="t" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GlideScrollPage" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit: restyles every ScrollBar (the result lists) as a thin rounded overlay thumb. -->
    <Style TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="9"/>
        <Setter Property="MinWidth" Value="9"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GlideScrollPage}" Command="ScrollBar.PageUpCommand"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource GlideScrollThumb}" MinHeight="26"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource GlideScrollPage}" Command="ScrollBar.PageDownCommand"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="9"/>
                <Setter Property="MinHeight" Value="9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================= Add-panel: selectable app/file tile ================= -->
    <Style x:Key="AppTileButton" TargetType="Button">
        <Setter Property="Width" Value="88"/>
        <Setter Property="Height" Value="90"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Command" Value="{Binding ToggleCommand}"/>
        <Setter Property="ToolTip" Value="{Binding Name}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="bd" Background="{DynamicResource TileBrush}" CornerRadius="12"
                                BorderBrush="Transparent" BorderThickness="1.5" Padding="6,10">
                            <StackPanel VerticalAlignment="Center">
                                <!-- Icon plate -->
                                <Border x:Name="plate" Width="46" Height="46" CornerRadius="11"
                                        HorizontalAlignment="Center" Margin="0,0,0,7"
                                        Background="{DynamicResource FieldBrush}">
                                    <Grid>
                                        <TextBlock Text="{Binding Glyph}" FontSize="19" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Image Source="{Binding Icon}" Width="30" Height="30"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"
                                           FontSize="10.5" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="78" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Selected check badge -->
                        <Border x:Name="check" Width="20" Height="20" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,-3,-3,0" Visibility="Collapsed">
                            <Path Data="M4.5 8.5 7 11l4.5-5" Stretch="Uniform" Width="11" Height="11"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary (outlined-ish) action button: Add file / Add folder -->
    <Style x:Key="AddSecondaryBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource TileBrush}" CornerRadius="8" Padding="11,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource TileHoverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary (accent) action button: Done -->
    <Style x:Key="AddPrimaryBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource AccentBrush}" CornerRadius="8" Padding="18,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Opacity" Value="0.9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuitBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="b" Background="{DynamicResource TileBrush}" CornerRadius="8" Padding="10,7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource CriticalBrush}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
