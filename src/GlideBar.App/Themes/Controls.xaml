    <PathGeometry x:Key="IconDocument" FillRule="Nonzero" Figures="M12 2v6c0 1.1.9 2 2 2h6v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4c0-1.1.9-2 2-2h6Zm1.5.5V8c0 .28.22.5.5.5h5.5l-6-6Z"/>
