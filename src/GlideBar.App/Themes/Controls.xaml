<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GlideBar.App.Controls"
                    xmlns:conv="clr-namespace:GlideBar.App.Converters">

    <conv:AllTrueConverter x:Key="AllTrue"/>
    <conv:InverseBoolToVisibilityConverter x:Key="InverseB2V"/>

    <!-- ================= Fluent System Icons (Microsoft, MIT) — vector, theme-recoloured ========= -->
