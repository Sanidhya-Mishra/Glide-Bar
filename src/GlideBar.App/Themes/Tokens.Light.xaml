<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ GlideBar design tokens — LIGHT ============ -->

    <!-- Surfaces (translucent so the DWM acrylic backdrop shows through) -->
    <!-- Pure-white panel matches the design gallery panel / bar-bg; alpha kept opaque since blur is off. -->
    <Color x:Key="SurfaceColor">#E8FFFFFF</Color>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#FFFFFFFF"/>

    <!-- Futuristic bar: white → soft lavender diagonal fill. -->
    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F7FFFFFF" Offset="0"/>
        <GradientStop Color="#F0EEF1FE" Offset="1"/>
    </LinearGradientBrush>
    <!-- Edge-light: translucent accent → violet rim stroke. -->
    <LinearGradientBrush x:Key="SurfaceStrokeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A65B7CFA" Offset="0"/>
        <GradientStop Color="#A68A5CF6" Offset="1"/>
    </LinearGradientBrush>
    <!-- Soft accent bloom for the outer glow. -->
    <Color x:Key="SurfaceGlowColor">#5B7CFA</Color>
    <SolidColorBrush x:Key="HandleBrush" Color="#73101223"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33101223"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#5C101223"/>

    <!-- Tiles / fields -->
    <SolidColorBrush x:Key="TileBrush" Color="#14101223"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#24101223"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#0F101223"/>

    <!-- Text (design tokens ink / muted) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#19202E"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6475"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#17101223"/>

    <!-- Accent + semantic -->
    <Color x:Key="AccentColor">#5B7CFA</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B7CFA"/>
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="#8A5CF6"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#1FB866"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#F0A020"/>
    <SolidColorBrush x:Key="CriticalBrush" Color="#EF4B4B"/>
    <SolidColorBrush x:Key="GaugeTrackBrush" Color="#1A101223"/>

    <!-- Shadow colour for the elevated surface -->
    <Color x:Key="ShadowColor">#33000000</Color>

    <!-- Geometry -->
    <CornerRadius x:Key="PillCornerRadius">26</CornerRadius>
    <CornerRadius x:Key="DockCornerRadius">15</CornerRadius>
    <CornerRadius x:Key="TileCornerRadius">10</CornerRadius>

</ResourceDictionary>
