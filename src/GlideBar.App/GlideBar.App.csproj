<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GlideBar.App</RootNamespace>
    <AssemblyName>GlideBar</AssemblyName>
    <!-- Per-Monitor-V2 DPI awareness (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlideBar.Core\GlideBar.Core.csproj" />
    <ProjectReference Include="..\GlideBar.HardwareMonitor\GlideBar.HardwareMonitor.csproj" />
    <ProjectReference Include="..\GlideBar.Search\GlideBar.Search.csproj" />
    <ProjectReference Include="..\GlideBar.Storage\GlideBar.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent D packages: MVVM, DI + hosting, system tray. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

</Project>
