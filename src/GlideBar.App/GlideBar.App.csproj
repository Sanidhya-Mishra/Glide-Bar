<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10.0.19041.0 target: required so the app can consume GlideBar.Media's WinRT
         (System Media Transport Controls) projection cleanly. Min OS stays Windows 10 1809+. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>GlideBar.App</RootNamespace>
    <AssemblyName>GlideBar</AssemblyName>
    <Version>1.2.0</Version>
    <!-- Per-Monitor-V2 DPI awareness (see app.manifest). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Embedded exe icon (shortcuts, Start menu, Programs &amp; Features). -->
    <ApplicationIcon>Assets\GlideBar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlideBar.Core\GlideBar.Core.csproj" />
    <ProjectReference Include="..\GlideBar.HardwareMonitor\GlideBar.HardwareMonitor.csproj" />
    <ProjectReference Include="..\GlideBar.Media\GlideBar.Media.csproj" />
    <ProjectReference Include="..\GlideBar.Search\GlideBar.Search.csproj" />
    <ProjectReference Include="..\GlideBar.Storage\GlideBar.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent D packages: MVVM, DI + hosting, system tray. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
  </ItemGroup>

</Project>
