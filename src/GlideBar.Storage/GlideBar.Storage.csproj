<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GlideBar.Core\GlideBar.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Only the DI abstractions are needed; System.Text.Json and Microsoft.Win32.Registry
         ship in the net10.0-windows targeting pack, so they need no package reference. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
